{
  "capability_id": "meridian_sign_on",
  "description": "Sign on to MERIDIAN CORE with operator ID, password, and branch, and reach the main menu.",
  "version": 1,
  "risk_class": "read_only",
  "expected_outcomes": [
    {
      "code": "INVALID_CREDENTIALS",
      "description": "The operator ID/password/branch combination was rejected by the sign-on form",
      "detection": {
        "type": "text_present",
        "value": "Invalid operator ID or password.",
        "scope": "page"
      }
    }
  ],
  "guardrails": {
    "allowlist_routes": [
      "/signon",
      "/menu"
    ],
    "allowed_action_types": [
      "select",
      "type",
      "click",
      "extract"
    ],
    "requires_confirmation": false
  },
  "evidence_policy": {
    "screenshot_on": [
      "checkpoint_failure",
      "hard_failure"
    ],
    "redact_fields": [
      "password"
    ]
  },
  "escalation_policy": {
    "default": {
      "on_checkpoint_failure": {
        "retry": 2,
        "then": "escalate"
      },
      "on_unrecognized_dialog": "escalate",
      "on_step_timeout": {
        "retry": 1,
        "then": "escalate"
      },
      "on_hard_failure": "escalate"
    }
  }
}
