{
  "schema_version": "1.0",
  "capability_id": "member_balance_lookup",
  "version": 1,
  "description": "Search for a member by ID and read their current savings balance.",
  "created_at": "2026-08-15T10:32:00Z",
  "created_by": "discovery_run",
  "source_run_id": "run_7f3a9c",
  "target": {
    "app": "legacy_bank_demo",
    "entry_point": "http://localhost:8000/members",
    "surface_type": "web_legacy"
  },
  "risk_class": "read_only",
  "inputs": [
    {
      "name": "member_id",
      "type": "string",
      "pattern": "^[0-9]{5}$",
      "required": true,
      "description": "5-digit member identifier"
    }
  ],
  "outputs": [
    {
      "name": "member_name",
      "type": "string",
      "description": "Full name of the member as displayed on the detail screen"
    },
    {
      "name": "savings_balance",
      "type": "money",
      "description": "Current savings balance in USD"
    }
  ],
  "expected_outcomes": [
    {
      "code": "MEMBER_NOT_FOUND",
      "description": "No member exists with the given ID",
      "detection": {
        "type": "text_present",
        "value": "No records found",
        "scope": "results_region"
      }
    },
    {
      "code": "ACCESS_DENIED",
      "description": "Current operator lacks permission to view this member",
      "detection": {
        "type": "text_present",
        "value": "You do not have permission",
        "scope": "page"
      }
    }
  ],
  "steps": [
    {
      "step_id": 1,
      "description": "Enter member ID into search field",
      "action": {
        "type": "type",
        "value": "{{member_id}}"
      },
      "locator": {
        "strategies": [
          {
            "kind": "accessibility",
            "role": "textbox",
            "name": "Member ID",
            "priority": 1
          },
          {
            "kind": "text_label",
            "label": "Member ID",
            "priority": 2
          },
          {
            "kind": "css",
            "selector": "input#memberIdSearch",
            "priority": 3
          }
        ]
      },
      "wait": {
        "type": "visible",
        "timeout_ms": 5000
      },
      "checkpoint": {
        "type": "field_value_equals",
        "expected": "{{member_id}}"
      }
    },
    {
      "step_id": 2,
      "description": "Click search button",
      "action": {
        "type": "click"
      },
      "locator": {
        "strategies": [
          {
            "kind": "accessibility",
            "role": "button",
            "name": "Search",
            "priority": 1
          },
          {
            "kind": "text_label",
            "label": "Search",
            "priority": 2
          },
          {
            "kind": "css",
            "selector": "button.search-btn",
            "priority": 3
          }
        ]
      },
      "wait": {
        "type": "network_idle",
        "timeout_ms": 8000
      },
      "checkpoint": {
        "type": "any_of",
        "conditions": [
          {
            "type": "element_visible",
            "role": "table",
            "name": "Search results"
          },
          {
            "type": "outcome_match",
            "outcome_codes": [
              "MEMBER_NOT_FOUND",
              "ACCESS_DENIED"
            ]
          }
        ]
      }
    },
    {
      "step_id": 3,
      "description": "Open member detail from results row",
      "action": {
        "type": "click"
      },
      "locator": {
        "strategies": [
          {
            "kind": "accessibility",
            "role": "link",
            "name": "{{member_id}}",
            "priority": 1
          },
          {
            "kind": "css",
            "selector": "table.results tr td:first-child a",
            "priority": 2
          }
        ]
      },
      "wait": {
        "type": "visible",
        "timeout_ms": 5000
      },
      "checkpoint": {
        "type": "element_visible",
        "role": "heading",
        "name_contains": "Member Detail"
      },
      "escalation_override": {
        "on_unrecognized_dialog": {
          "retry": 0,
          "then": "escalate"
        }
      }
    },
    {
      "step_id": 4,
      "description": "Read member name and savings balance",
      "action": {
        "type": "extract",
        "fields": [
          {
            "output": "member_name",
            "locator": {
              "strategies": [
                {
                  "kind": "accessibility",
                  "role": "text",
                  "name_matches": "^Name:",
                  "priority": 1
                },
                {
                  "kind": "css",
                  "selector": "td.member-name",
                  "priority": 2
                }
              ]
            }
          },
          {
            "output": "savings_balance",
            "locator": {
              "strategies": [
                {
                  "kind": "accessibility",
                  "role": "text",
                  "name_matches": "^Savings Balance:",
                  "priority": 1
                },
                {
                  "kind": "css",
                  "selector": "td.savings-balance",
                  "priority": 2
                }
              ]
            }
          }
        ]
      },
      "checkpoint": {
        "type": "outputs_non_empty",
        "fields": [
          "member_name",
          "savings_balance"
        ]
      }
    }
  ],
  "guardrails": {
    "allowlist_routes": [
      "/members",
      "/members/*"
    ],
    "allowed_action_types": [
      "type",
      "click",
      "extract"
    ],
    "requires_confirmation": false
  },
  "evidence_policy": {
    "screenshot_on": [
      "checkpoint_failure",
      "hard_failure"
    ],
    "redact_fields": [
      "ssn",
      "account_number",
      "password"
    ]
  },
  "escalation_policy": {
    "default": {
      "on_checkpoint_failure": {
        "retry": 2,
        "then": "escalate"
      },
      "on_unrecognized_dialog": "escalate",
      "on_step_timeout": {
        "retry": 1,
        "then": "escalate"
      },
      "on_hard_failure": "escalate"
    }
  }
}